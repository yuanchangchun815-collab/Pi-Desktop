{
  "name": "pi-desktop",
  "version": "0.1.0",
  "description": "A desktop application to use and control pi, the coding agent.",
  "author": "Pi Desktop contributors",
  "license": "MIT",
  "keywords": [
    "electron",
    "pi",
    "coding-agent",
    "ai",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yuanchangchun815-collab/Pi-Desktop.git"
  },
  "bugs": {
    "url": "https://github.com/yuanchangchun815-collab/Pi-Desktop/issues"
  },
  "homepage": "https://github.com/yuanchangchun815-collab/Pi-Desktop#readme",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer && npm run build:assets",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "esbuild renderer/app.ts --bundle --format=esm --outfile=dist/renderer/app.bundle.js --sourcemap --external:electron",
    "build:assets": "node scripts/copy-assets.mjs",
    "watch": "tsc -w -p tsconfig.json",
    "lint": "eslint electron/ renderer/ scripts/*.mjs",
    "format": "prettier --write \"electron/**/*.ts\" \"renderer/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"electron/**/*.ts\" \"renderer/**/*.ts\" \"scripts/*.mjs\"",
    "test": "npm run build:main && node --test \"test/*.test.mjs\"",
    "start": "npm run build && electron .",
    "start:dev": "npm run build && cross-env PI_DESKTOP_DEV=1 electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "icons": "node scripts/build-icons/generate-png.mjs && node scripts/build-icons/generate-ico.mjs && node scripts/build-icons/make-icns.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@lezer/highlight": "^1.2.3",
    "dompurify": "^3.4.14",
    "jszip": "^3.10.1",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0"
  },
  "build": {
    "appId": "dev.pidesktop.app",
    "productName": "Pi Desktop",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "yuanchangchun815-collab",
      "repo": "Pi-Desktop"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
